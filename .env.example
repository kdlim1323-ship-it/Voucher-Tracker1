# Voucher Tracker - Environment Variables Template
# Copy this file to .env.local for local development.
# IMPORTANT: Use placeholder values only. Never commit real API keys or administrative secrets.

# Firebase Client Configuration (Spark Plan / Free Tier)
VITE_FIREBASE_API_KEY=AIzaSyPlaceholderAPIKey1234567890
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:abcdef1234567890
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
